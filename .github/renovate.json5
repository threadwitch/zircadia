{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  // Keep base-image digest bumps to a reviewed weekly cadence rather than a
  // continuous stream of PRs (issue #2).
  "schedule": ["before 6am on monday"],

  // The zirconium base images are referenced as build-args / shell assignments
  // rather than in a place Renovate's built-in managers parse, so detect the
  // digest-pinned references via the `# renovate:` annotations next to them.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/build\\.yml$/",
        "/^Justfile$/",
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s[\\s\\S]*?:(?<currentValue>\\S+?)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      "datasourceTemplate": "docker",
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build_files/05-util-install\\.sh$/",
      ],
      "matchStrings": [
        "datasource=(?<datasource>github-releases|crate) depName=(?<depName>\\S+)\\s+(?:[a-z_]+_version)=\"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      // Track the release asset digest together with the full GitHub release tag.
      "customType": "regex",
      "managerFilePatterns": ["/^build_files/05-util-install\\.sh$/"],
      "matchStrings": [
        "datasource=(?<datasource>github-release-attachments) depName=(?<depName>jj-vcs/jj)\\r?\\njj_version=\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\"\\r?\\njj_url=\"[^\"\\r\\n]+\"\\r?\\njj_sha256=\"(?<currentDigest>[a-f0-9]{64})\"",
      ],
      "versioningTemplate": "semver-coerced",
    },
  ],

  "packageRules": [
    {
      // osbuild's nested mounts fail on Ubuntu 26.04. Keep this disk builder
      // on 24.04 while the image architecture is being replaced.
      "matchManagers": ["github-actions"],
      "matchDatasources": ["github-runners"],
      "matchDepNames": ["ubuntu"],
      "matchFileNames": [".github/workflows/build-disk.yml"],
      "allowedVersions": "/^24\\.04$/",
    },
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
    {
      // Release assets remain reviewed updates. jj tracks its asset digest;
      // sops and age-plugin-tpm still need manual checksum updates.
      "matchDepNames": [
        "Foxboron/age-plugin-tpm",
        "getsops/sops",
        "jj-vcs/jj",
      ],
      "automerge": false,
    },
    {
      // Base-image digest bumps are reviewed merges, never auto-merged.
      "matchDepNames": [
        "ghcr.io/zirconium-dev/zirconium",
      ],
      "groupName": "zirconium base image",
      "automerge": false,
    },
  ]
}
